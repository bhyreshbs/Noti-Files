<Window x:Class="FileActivityNotifier.UI.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Microsoft.UI.Xaml.Controls"
        xmlns:media="using:Microsoft.UI.Xaml.Media"
        xmlns:animations="using:Microsoft.UI.Xaml.Media.Animation"
        xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
        Title="Noti-Files">

    <Grid x:ConnectionId='2' x:Name="DashboardRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:ConnectionId='3' x:Name="RootNavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        OpenPaneLength="200"
                                                                   >
            <NavigationView.MenuItems>
                <NavigationViewItem x:ConnectionId='4' x:Name="ActivityNavItem"
                                    Content="Activity"
                                    Tag="activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;"
                                  FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:ConnectionId='5' x:Name="SettingsNavItem"
                                    Content="Settings"
                                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"
                                  FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.Header>
                <Grid Margin="0,0,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="14,10"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Renamed"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding RenamedToday}"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="14,10"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Moved"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding MovedToday}"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4"
                            Padding="14,10"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Downloaded"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding DownloadedToday}"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <ToggleButton x:ConnectionId='6' Grid.Column="6"
                                  x:Name="PauseResumeToggle"
                                  VerticalAlignment="Center"
                                  MinHeight="38"
                                  Padding="14,0"
                                                                     
                                                                         >
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:ConnectionId='7' x:Name="PauseResumeIcon"
                                      FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE769;"
                                      FontSize="14" />
                            <TextBlock x:ConnectionId='8' x:Name="PauseResumeLabel"
                                       Text="Pause Monitoring"
                                       FontFamily="Segoe UI Variable Text" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
            </NavigationView.Header>

            <Grid Margin="0,0,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar x:ConnectionId='9' x:Name="MonitoringInfoBar"
                         Grid.Row="0"
                         IsOpen="True"
                         Severity="Success"
                         Title="Monitoring Active"
                         Message="File activity watcher is running." />

                <Border Grid.Row="2"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Frame x:ConnectionId='10' x:Name="ContentFrame" Margin="10" />
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>

