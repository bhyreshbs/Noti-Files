<Window x:Class="FileActivityNotifier.UI.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Microsoft.UI.Xaml.Controls"
        xmlns:media="using:Microsoft.UI.Xaml.Media"
        xmlns:animations="using:Microsoft.UI.Xaml.Media.Animation"
        xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
        Title="Noti-Files">

    <Grid x:ConnectionId='2' x:Name="DashboardRoot" UseLayoutRounding="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0D1426" Offset="0" />
                <GradientStop Color="#FF111B31" Offset="0.5" />
                <GradientStop Color="#FF17233D" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <NavigationView x:ConnectionId='3' x:Name="RootNavView"
                        PaneDisplayMode="Left"
                        AlwaysShowHeader="True"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        CompactPaneLength="56"
                        OpenPaneLength="146"
                                                                   >
            <NavigationView.MenuItems>
                <NavigationViewItem x:ConnectionId='4' x:Name="ActivityNavItem"
                                    Content="Activity"
                                    Tag="activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;"
                                  FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:ConnectionId='5' x:Name="SettingsNavItem"
                                    Content=""
                                    ToolTipService.ToolTip="Settings"
                                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"
                                  FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Header>
                <Grid x:ConnectionId='6' x:Name="DashboardHeader" Margin="-4,0,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="10,8"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Renamed"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding RenamedToday}"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="10,8"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Moved"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding MovedToday}"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4"
                            Padding="10,8"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Downloaded"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding DownloadedToday}"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <ToggleButton x:ConnectionId='7' Grid.Column="6"
                                  x:Name="PauseResumeToggle"
                                  Width="146"
                                  VerticalAlignment="Center"
                                  MinHeight="38"
                                  Padding="12,0"
                                  Foreground="White"
                                  BorderThickness="0"
                                  Background="#FF2B6DEB"
                                  CornerRadius="10"
                                                                     
                                                                         
                                                                                   
                                                                                 
                                                                                   
                                                                                     >
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:ConnectionId='8' x:Name="PauseResumeIcon"
                                      FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE769;"
                                      FontSize="14" />
                            <TextBlock x:ConnectionId='9' x:Name="PauseResumeLabel"
                                       Text="Pause"
                                       FontFamily="Segoe UI Variable Text" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
            </NavigationView.Header>

            <Grid Margin="0,0,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:ConnectionId='10' x:Name="ContentTopSpacerRow" Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar x:ConnectionId='11' x:Name="MonitoringInfoBar"
                         Grid.Row="0"
                         IsOpen="True"
                         Severity="Success"
                         Title="Monitoring Active"
                         Message="File activity watcher is running." />

                <Border x:ConnectionId='12' Grid.Row="2"
                    x:Name="ContentHost"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Frame x:ConnectionId='13' x:Name="ContentFrame" Margin="6" />
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>

