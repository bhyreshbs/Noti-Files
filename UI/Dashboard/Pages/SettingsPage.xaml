<Page x:Class="FileActivityNotifier.UI.Dashboard.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Microsoft.UI.Xaml.Controls"
      xmlns:media="using:Microsoft.UI.Xaml.Media"
      xmlns:animations="using:Microsoft.UI.Xaml.Media.Animation"
      xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="SettingsActionButtonStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <Style TargetType="primitives:ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Enabled"
                  HorizontalScrollMode="Disabled"
                  Padding="8,0,8,8">
        <StackPanel Spacing="12" UseLayoutRounding="True">
            <Border Padding="14"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Watched Folders"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <ListView x:Name="FoldersListView"
                              MinHeight="116"
                              SelectionMode="Single" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource SettingsActionButtonStyle}" Content="Add Folder" Click="AddFolderButton_Click" />
                        <Button Style="{StaticResource SettingsActionButtonStyle}" Content="Remove Selected" Click="RemoveFolderButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="14"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Allowed Extensions"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <Grid ColumnSpacing="14" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="DocxExtensionCheckBox" Grid.Row="0" Grid.Column="0" Content=".docx" Tag=".docx" Checked="ExtensionCheckBox_Changed" Unchecked="ExtensionCheckBox_Changed" />
                        <CheckBox x:Name="PdfExtensionCheckBox" Grid.Row="0" Grid.Column="1" Content=".pdf" Tag=".pdf" Checked="ExtensionCheckBox_Changed" Unchecked="ExtensionCheckBox_Changed" />
                        <CheckBox x:Name="XlsxExtensionCheckBox" Grid.Row="0" Grid.Column="2" Content=".xlsx" Tag=".xlsx" Checked="ExtensionCheckBox_Changed" Unchecked="ExtensionCheckBox_Changed" />
                        <CheckBox x:Name="JpgExtensionCheckBox" Grid.Row="0" Grid.Column="3" Content=".jpg" Tag=".jpg" Checked="ExtensionCheckBox_Changed" Unchecked="ExtensionCheckBox_Changed" />
                        <CheckBox x:Name="PngExtensionCheckBox" Grid.Row="1" Grid.Column="0" Content=".png" Tag=".png" Checked="ExtensionCheckBox_Changed" Unchecked="ExtensionCheckBox_Changed" />
                        <CheckBox x:Name="Mp4ExtensionCheckBox" Grid.Row="1" Grid.Column="1" Content=".mp4" Tag=".mp4" Checked="ExtensionCheckBox_Changed" Unchecked="ExtensionCheckBox_Changed" />
                        <CheckBox x:Name="ZipExtensionCheckBox" Grid.Row="1" Grid.Column="2" Content=".zip" Tag=".zip" Checked="ExtensionCheckBox_Changed" Unchecked="ExtensionCheckBox_Changed" />
                        <CheckBox x:Name="TxtExtensionCheckBox" Grid.Row="1" Grid.Column="3" Content=".txt" Tag=".txt" Checked="ExtensionCheckBox_Changed" Unchecked="ExtensionCheckBox_Changed" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="14"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Theme" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ThemeComboBox" Width="180" SelectionChanged="ThemeComboBox_SelectionChanged">
                        <x:String>Dark</x:String>
                        <x:String>Light</x:String>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Notification Duration" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider x:Name="DurationSlider"
                                Width="220"
                                Minimum="2"
                                Maximum="15"
                                StepFrequency="0.5"
                                ValueChanged="DurationSlider_ValueChanged" />
                        <TextBlock x:Name="DurationLabel"
                                   VerticalAlignment="Center"
                                   FontFamily="Cascadia Mono"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Max Stack Count" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="MaxStackComboBox" Width="180" SelectionChanged="MaxStackComboBox_SelectionChanged" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Start with Windows" VerticalAlignment="Center" />
                    <CheckBox Grid.Row="3" Grid.Column="1" x:Name="StartupCheckBox" Content="Enable" Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
