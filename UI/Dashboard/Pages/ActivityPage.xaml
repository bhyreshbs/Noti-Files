<Page x:Class="FileActivityNotifier.UI.Dashboard.Pages.ActivityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Microsoft.UI.Xaml.Controls"
      xmlns:conv="using:FileActivityNotifier.UI.Converters"
      xmlns:media="using:Microsoft.UI.Xaml.Media"
      xmlns:animations="using:Microsoft.UI.Xaml.Media.Animation"
      xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <conv:FileTypeToIconConverter x:Key="FileTypeToIconConverter" />
        <conv:DateTimeToAgoConverter x:Key="DateTimeToAgoConverter" />

        <Style x:Key="ActivityPrimaryButtonStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF276EF1" Offset="0" />
                        <GradientStop Color="#FF3C8CFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="primitives:ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
        </Style>
    </Page.Resources>

    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     MinHeight="36"
                     VerticalAlignment="Center"
                     PlaceholderText="Search by filename or path"
                     TextChanged="SearchBox_TextChanged" />

            <ComboBox x:Name="FilterComboBox"
                      Grid.Column="2"
                      MinHeight="36"
                      VerticalAlignment="Center"
                      SelectedIndex="0"
                      SelectionChanged="FilterComboBox_SelectionChanged">
                <x:String>All</x:String>
                <x:String>Renamed</x:String>
                <x:String>Moved</x:String>
                <x:String>Downloaded</x:String>
                <x:String>Today</x:String>
                <x:String>This Week</x:String>
            </ComboBox>

            <Button Grid.Column="4"
                    Style="{StaticResource ActivityPrimaryButtonStyle}"
                    VerticalAlignment="Center"
                    Content="Clear Log"
                    Click="ClearLogButton_Click" />
        </Grid>

        <Border Grid.Row="2"
                CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <ScrollViewer Margin="5"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Enabled"
                              HorizontalScrollMode="Disabled">
                    <controls:ItemsRepeater x:Name="EventsRepeater"
                                            ItemsSource="{Binding FilteredEvents}">
                        <controls:ItemsRepeater.Layout>
                            <controls:StackLayout Spacing="6" />
                        </controls:ItemsRepeater.Layout>

                        <controls:ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="32"
                                                Height="32"
                                                CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <Image Width="24"
                                                   Height="24"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Source="{Binding FileExtension, Converter={StaticResource FileTypeToIconConverter}}" />
                                        </Border>

                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding FileName}"
                                                           FontFamily="Segoe UI Variable Display"
                               FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                                <Border Grid.Column="1"
                                                        Margin="8,0,0,0"
                            Padding="7,2"
                                                        CornerRadius="10"
                                                        Background="{Binding EventBadgeBackground}"
                                                        BorderBrush="{Binding EventBadgeForeground}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding EventType}"
                                                               FontFamily="Segoe UI Variable Text"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding EventBadgeForeground}" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding FilePath}"
                                                       FontFamily="Cascadia Mono"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons"
                                                          Glyph="&#xE823;"
                                                          FontSize="11"
                                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{Binding Timestamp, Converter={StaticResource DateTimeToAgoConverter}}"
                                                           FontFamily="Cascadia Mono"
                                                           FontSize="10"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </controls:ItemsRepeater.ItemTemplate>
                    </controls:ItemsRepeater>
                </ScrollViewer>

                <StackPanel x:Name="EmptyStatePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="No activity yet"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Start monitoring files to populate this feed."
                               FontFamily="Segoe UI Variable Text"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
